# Keep original MacLock hashes, JS template literals and packaged text identical
# on Windows and Unix. Do not weaken the original-source integrity tests.
* text=auto
*.js text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.qml text eol=lf
*.frag text eol=lf
*.vert text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.sh text eol=lf
third_party/maclock/LICENSE text eol=lf
third_party/glass2/LICENSE text eol=lf
*.otf binary
*.png binary
*.jpg binary
*.airapp binary

# Preserve pinned upstream distribution byte hashes, including CRLF.
third_party/winbox-0.2.82/* -text whitespace=cr-at-eol

# R2: preserve pinned Tahoe Sass and license/NOTICE bytes on Windows checkouts.
# These upstream assets are hashed verbatim, including any original line endings.
third_party/tahoe/** -text
third_party/deep-port/** -text
third_party/macbar/** -text
# Tahoe 6 source excerpts and copyright remain byte-stable on Windows.
third_party/tahoe6/** -text
third_party/tahoe7/** -text

# Preserve pinned material-callsite excerpts on Windows.
third_party/glass2/** -text

third_party/evolution1/original/* -text
# Evolution1: MIT/LICENSE/NOTICE must retain exact bytes in native Windows R4.
third_party/evolution1/** -text
third_party/r5/** -text
