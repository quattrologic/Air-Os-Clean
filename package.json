{
  "name": "air-os-desktop",
  "version": "1.0.3",
  "description": "Air-OS cross-platform desktop environment",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --publish never --win --x64 --arm64",
    "pack:mac": "npm run check:catalina && electron-builder --publish never --mac dmg zip --universal",
    "pack:linux": "electron-builder --publish never --linux AppImage deb",
    "dist": "electron-builder",
    "check:catalina": "node scripts/check-catalina.cjs",
    "test": "node --test tests/*.test.cjs",
    "check:modern": "node scripts/check-modern.cjs",
    "pack:mac:modern": "npm run check:modern && electron-builder --publish never --mac dmg zip --universal --config.mac.minimumSystemVersion=13.0.0",
    "build:pwa": "node scripts/build-pwa.cjs"
  },
  "devDependencies": {
    "electron": "32.3.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.quattrologic.airos",
    "productName": "Air-OS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "styles.css",
      "air-modern-dock.css",
      "air-island.css",
      "air-island.js",
      "app.js",
      "src/core/app-registry.js",
      "airwrite.js",
      "airwrite.css",
      "air-os-enhancements.js",
      "air-os-enhancements.css",
      "wallpaper.svg",
      "wallpaper.jpg",
      "login.html",
      "login.css",
      "login.js",
      "maclock-layout.js",
      "maclock-shaders.js",
      "maclock-glass.js",
      "maclock-motion.js",
      "maclock-morph.js",
      "maclock-wallpaper.svg",
      "third_party/maclock/**/*",
      "README.md",
      "package.json",
      "aircard-lite.js",
      "aircard/**/*",
      "air-extra-apps.js",
      "air-extra-apps.css",
      "air-arcade-games.js",
      "air-arcade-games.css",
      "air-music.js",
      "air-music.css",
      "src/core/app-lifecycle.js",
      "air-launchpad.js",
      "air-launchpad.css",
      "src/main/preferences.cjs",
      "src/core/search-service.js",
      "air-spotlight.js",
      "air-spotlight.css",
      "src/main/notes-store.cjs",
      "air-notes.js",
      "src/main/airapp-package.cjs",
      "src/main/airapp-manager.cjs",
      "src/main/airapp-runtime.cjs",
      "src/main/spotify-launcher.cjs",
      "src/main/chatgpt-installation.cjs",
      "store/catalog/**/*",
      "store/keys/**/*",
      "air-app-store.js",
      "air-app-store.css",
      "air-app-bootstrap.js",
      "src/main/file-ops.cjs",
      "src/main/file-search.cjs",
      "src/main/reminders-store.cjs",
      "air-reminders.js",
      "air-reminders.css",
      "assets/brand/**/*",
      "src/main/cloud-notes.cjs",
      "air-cloud.js",
      "air-cloud.css",
      "src/core/notes-format.js",
      "air-calendar.js",
      "air-calendar.css",
      "third_party/macbar/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "10.15.0",
      "icon": "assets/brand/air-os.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}",
      "icon": "assets/brand/air-os.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/brand/air-os.ico",
      "uninstallerIcon": "assets/brand/air-os.ico",
      "installerHeaderIcon": "assets/brand/air-os.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "aircard",
        "to": "aircard",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "author": "Air-OS",
  "dependencies": {
    "amplitudejs": "5.3.2"
  }
}
