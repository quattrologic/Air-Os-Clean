{
  "name": "air-os-desktop",
  "version": "1.0.3",
  "description": "Air-OS cross-platform desktop environment",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --publish never --win --x64 --arm64",
    "pack:mac": "npm run check:catalina && electron-builder --publish never --mac dmg zip --universal",
    "pack:linux": "electron-builder --publish never --linux AppImage deb",
    "dist": "electron-builder",
    "check:catalina": "node scripts/check-catalina.cjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.quattrologic.airos",
    "productName": "Air-OS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "styles.css",
      "app.js",
      "airwrite.js",
      "airwrite.css",
      "air-os-enhancements.js",
      "air-os-enhancements.css",
      "wallpaper.svg",
      "wallpaper.jpg",
      "login.html",
      "login.css",
      "login.js",
      "README.md",
      "package.json",
      "aircard-lite.js",
      "aircard/**/*",
      "air-extra-apps.js",
      "air-extra-apps.css",
      "air-arcade-games.js",
      "air-arcade-games.css",
      "air-music.js",
      "air-music.css"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "10.15.0"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "aircard",
        "to": "aircard",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "author": "Air-OS",
  "dependencies": {
    "amplitudejs": "5.3.2"
  }
}
